[configuration]

entry_symbol = "aov_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://native/bin/libaov.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libaov.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://native/bin/libaov.linux.template_debug.arm64.so"
linux.release.arm64 = "res://native/bin/libaov.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://native/bin/libaov.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libaov.windows.template_release.x86_64.dll"
macos.debug = "res://native/bin/libaov.macos.template_debug.framework"
macos.release = "res://native/bin/libaov.macos.template_release.framework"
web.debug.threads.wasm32 = "res://native/bin/libaov.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://native/bin/libaov.web.template_release.wasm32.wasm"
web.debug.wasm32 = "res://native/bin/libaov.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "res://native/bin/libaov.web.template_release.wasm32.nothreads.wasm"
